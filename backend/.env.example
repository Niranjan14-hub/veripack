# Leave MONGODB_URI empty to fall back to the local JSON store (no Atlas needed).
MONGODB_URI=
MONGODB_DB=veripack

# Leave GEMINI_API_KEY empty to fall back to the heuristic label parser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Signing key for auth tokens. Leave empty for a per-process dev secret
# (tokens stop working when the server restarts). Set a long random value in production.
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
